# ─────────────────────────────────────────────────────────────
# Default Admin Credentials
# ─────────────────────────────────────────────────────────────
# These will be automatically created on container startup if they don't exist
ADMIN_EMAIL="admin@proctorai.local"
ADMIN_PASSWORD="admin123"

# ─────────────────────────────────────────────────────────────────
# AI Proctored Exam — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Story 1.1: No real values required yet (mock server only).
# ─────────────────────────────────────────────────────────────────

# ── Database (Story 1.2+) ────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_proctored_exam

# ── LLM Provider (Story 4.1+) ───────────────
# Uncomment the LLM provider you want to use.
# LangChain will pick this up automatically.
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# OLLAMA_BASE_URL=http://localhost:11434   # for self-hosted Ollama

GEMINI_MODEL="gemini-3.1-flash-lite"

# ── Authentication ───────────────────────────
# Secret key used for signing JWT tokens. Must be at least 32 bytes for HS256 algorithm.
JWT_SECRET_KEY="super_secret_key_that_is_at_least_32_bytes_long_for_hs256"

# ── App Settings ─────────────────────────────
MAX_VIOLATIONS=3
MAX_MAIN_QUESTIONS=5
MAX_FOLLOW_UPS_PER_QUESTION=1

# ── Proctoring Settings ──────────────────────
# PROCTORING_ENABLED controls whether proctoring checks and violation logs are enforced.
PROCTORING_ENABLED=true
# ALLOW_PROCTORING_TOGGLE controls whether the UI shows the pause/resume toggle button.
# Set to true during local development to allow pausing proctoring checks from the UI.
# Must be false in production so candidates cannot disable proctoring.
ALLOW_PROCTORING_TOGGLE=false
